# ---------------------------------------------------------------------------
# Unity
# ---------------------------------------------------------------------------
# These folders are GENERATED by Unity from the contents of Assets/ +
# ProjectSettings/ + Packages/. They are large, machine-specific, and rebuilt
# automatically. Committing them causes constant, meaningless merge conflicts.
# Deleting Library/ and reopening the project is a standard Unity repair step.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset Store downloads re-download on demand
[Aa]ssets/AssetStoreTools*

# Unity-generated IDE project files (regenerated from the .csproj templates)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage.meta
*.app

# Gradle / Android
.gradle/
ExportedObj/
.consulo/

# ---------------------------------------------------------------------------
# IDEs
# ---------------------------------------------------------------------------
.vs/
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
